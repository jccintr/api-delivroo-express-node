# Copie para ".env" e preencha. Nunca coloque valores reais neste arquivo.

# ---------- Servidor ----------
PORT=3000

# ---------- Banco de dados (MongoDB Atlas) ----------
DB_CONNECTION_PROD=mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/NOME_DO_BANCO

# ---------- Segredos JWT (use textos longos e diferentes entre si) ----------
JWT_SECRET_ADMIN=
JWT_SECRET_STORE=
JWT_SECRET_RIDER=

# ---------- E-mail (SMTP, porta 465) ----------
SMTP_HOST=smtp.exemplo.com
SMTP_USER=contato@seudominio.com
SMTP_PASSWORD=

# ---------- Cloudinary (fotos e comprovantes) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Google Maps ----------
GOOGLE_MAPS_API_KEY=

# ---------- Notificações push (Expo) ----------
EXPO_ACCESS_TOKEN=

# ---------- Pacotes de entregas pagos por Pix ----------
# Chave Pix que recebe: CPF/CNPJ só com dígitos, e-mail, telefone (+5511999999999) ou chave aleatória
PIX_KEY=
# Nome de quem recebe (máx. 25 caracteres, aparece no app do banco do lojista)
PIX_RECEIVER_NAME=
# Cidade de quem recebe (máx. 15 caracteres)
PIX_RECEIVER_CITY=
# (opcional) texto curto que aparece no app do pagador
PIX_DESCRIPTION=Delivroo Express
# E-mail(s) que recebem o aviso "Já paguei"; separe vários por vírgula
ADMIN_NOTIFICATION_EMAIL=
# (opcional) endereço do painel admin, usado como link no e-mail de aviso
ADMIN_PANEL_URL=

# ---------- Opcional ----------
# Intervalo do ping do WebSocket em milissegundos (padrão 30000)
# WS_HEARTBEAT_INTERVAL_MS=30000
